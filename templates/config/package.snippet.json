{
  "_comment": "Fragmento a FUSIONAR en el package.json del servicio (no reemplazar). Define scripts de calidad, hooks y dependencias del dataset.",
  "scripts": {
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "verify:standards": "node scripts/verify-standards.mjs",
    "verify": "npm run lint:check && npm run verify:standards",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.ts": ["eslint --fix", "prettier --write"]
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/typeorm": "^11",
    "class-transformer": "^0.5",
    "class-validator": "^0.14",
    "helmet": "^8",
    "joi": "^17",
    "log4js": "^6",
    "reflect-metadata": "^0.1",
    "rxjs": "^7",
    "typeorm": "^0.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6",
    "@typescript-eslint/parser": "^6",
    "eslint": "^8",
    "eslint-config-prettier": "^9",
    "eslint-plugin-prettier": "^5",
    "husky": "^9",
    "lint-staged": "^16",
    "prettier": "^3"
  }
}
